{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=development.db;Foreign Keys=True"
  },
  "ApiAuthentication": {
    "Token": "111"
  },
  "Authentication": {
    "InitialUser": {
      "Username": "admin",
      "Password": "123"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/application-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ProductionManagement.Api"
    }
  },
  "AllowedHosts": "*"
}
