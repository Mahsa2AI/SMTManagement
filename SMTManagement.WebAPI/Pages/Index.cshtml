@page
@model SMTManagement.WebAPI.Pages.IndexModel
@{
    ViewData["Title"] = "Management";
}
<div class="page-heading">
    <div><p class="eyebrow">SMT production workspace</p><h1>Production management</h1><p class="muted">Create your production data, connect boards to orders, and prepare an order for the production line.</p></div>
    <div class="stats"><span><b>@Model.Orders.Count</b> orders</span><span><b>@Model.Boards.Count</b> boards</span><span><b>@Model.Components.Count</b> components</span></div>
</div>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <p class="error">The API rejected the request: @Model.ErrorMessage</p> }
<nav class="tabs" aria-label="Management sections">
    <button class="tab is-active" data-tab="orders">Orders</button><button class="tab" data-tab="boards">Boards</button><button class="tab" data-tab="components">Components</button>
</nav>
<section class="tab-panel is-active" data-panel="orders">
    <div class="toolbar"><form method="get" class="search-form"><input name="OrderSearch" value="@Model.OrderSearch" placeholder="Search orders..." /><button class="button" type="submit">Search</button></form><button class="button" data-open="new-order">+ New order</button></div>
    <div class="card table-card"><table><thead><tr><th>Order</th><th>Order date</th><th>Boards</th><th class="actions-column">Actions</th></tr></thead><tbody>
    @foreach (var order in Model.Orders) {
        <tr class="order-row"><td><button class="expand-button" type="button" data-expand="order-details-@order.Id" aria-expanded="false" aria-controls="order-details-@order.Id">+</button><strong>@order.Name</strong><br /><small>@order.Description</small></td><td>@order.OrderDate.ToShortDateString()</td><td><span class="badge">@order.Boards.Count boards</span></td><td class="row-actions"><button class="button button-secondary" data-open="edit-order-@order.Id">Edit</button><button class="button button-secondary" data-open="order-@order.Id">Manage boards</button><form method="post" asp-page-handler="DownloadOrder"><input type="hidden" name="OrderId" value="@order.Id" /><button class="button" type="submit">Send to production</button></form><form method="post" asp-page-handler="DeleteOrder"><input type="hidden" name="OrderId" value="@order.Id" /><button class="icon-button" title="Delete order" type="submit">Delete</button></form></td></tr>
        <tr class="order-detail-row" id="order-details-@order.Id" hidden><td colspan="4"><div class="order-detail"><div class="board-detail-header"><div><p class="eyebrow">Order details</p><h3>@order.Name</h3></div><span class="badge">ID: @order.Id</span></div><div class="detail-grid"><div><small>Description</small><strong>@(string.IsNullOrWhiteSpace(order.Description) ? "No description" : order.Description)</strong></div><div><small>Order date</small><strong>@order.OrderDate.ToLocalTime().ToShortDateString()</strong></div><div><small>Boards</small><strong>@order.Boards.Count assigned</strong></div></div><div class="component-summary"><div class="summary-heading"><strong>Boards and components in this order</strong><span class="badge">@order.Boards.Sum(board => board.Components.Count) components</span></div>@if (order.Boards.Count == 0) { <p class="muted">No boards assigned yet. Use “Manage boards” to add boards.</p> } else { <div class="order-board-list">@foreach (var board in order.Boards) { <div class="order-board-card"><div><strong>@board.Name</strong><small>@board.Length x @board.Width · @board.Components.Count components</small></div>@if (board.Components.Count == 0) { <span class="muted">No components</span> } else { <div class="order-component-list">@foreach (var component in board.Components) { <span class="component-pill">@component.Name <small>x @component.Quantity</small></span> }</div> }</div> }</div> }</div></div></td></tr>
    }
    </tbody></table></div>
</section>
<section class="tab-panel" data-panel="boards">
    <div class="toolbar"><form method="get" class="search-form"><input name="BoardSearch" value="@Model.BoardSearch" placeholder="Search boards..." /><button class="button" type="submit">Search</button></form><button class="button" data-open="new-board">+ New board</button></div>
    <div class="card table-card"><table><thead><tr><th>Board</th><th>Dimensions</th><th>Components</th><th class="actions-column">Actions</th></tr></thead><tbody>
    @foreach (var board in Model.Boards) {
        <tr class="board-row">
            <td><button class="expand-button" type="button" data-expand="board-details-@board.Id" aria-expanded="false" aria-controls="board-details-@board.Id">+</button><strong>@board.Name</strong><br /><small>@board.Description</small></td>
            <td>@board.Length x @board.Width</td>
            <td><span class="badge">@board.Components.Count components</span></td>
            <td class="row-actions"><button class="button button-secondary" data-open="edit-board-@board.Id">Edit</button><button class="button button-secondary" data-open="board-@board.Id">Manage components</button><form method="post" asp-page-handler="DeleteBoard"><input type="hidden" name="BoardId" value="@board.Id" /><button class="icon-button" title="Delete board" type="submit">Delete</button></form></td>
        </tr>
        <tr class="board-detail-row" id="board-details-@board.Id" hidden>
            <td colspan="4">
                <div class="board-detail">
                    <div class="board-detail-header"><div><p class="eyebrow">Board details</p><h3>@board.Name</h3></div><span class="badge">ID: @board.Id</span></div>
                    <div class="detail-grid"><div><small>Description</small><strong>@(string.IsNullOrWhiteSpace(board.Description) ? "No description" : board.Description)</strong></div><div><small>Dimensions</small><strong>@board.Length x @board.Width</strong></div><div><small>Created</small><strong>@board.CreatedAt.ToLocalTime().ToShortDateString()</strong></div></div>
                    <div class="component-summary"><div class="summary-heading"><strong>Components on this board</strong><span class="badge">@board.Components.Count total</span></div>
                        @if (board.Components.Count == 0) { <p class="muted">No components assigned yet. Use “Manage components” to add them.</p> } else { <div class="component-cards">@foreach (var component in board.Components) { <div class="component-card"><strong>@component.Name</strong><span>Quantity: @component.Quantity</span><small>@component.Description</small></div> }</div> }
                    </div>
                </div>
            </td>
        </tr>
    }
    </tbody></table></div>
</section>
<section class="tab-panel" data-panel="components">
    <div class="toolbar"><form method="get" class="search-form"><input name="ComponentSearch" value="@Model.ComponentSearch" placeholder="Search components..." /><button class="button" type="submit">Search</button></form><button class="button" data-open="new-component">+ New component</button></div>
    <div class="card table-card"><table><thead><tr><th>Component</th><th>Quantity</th><th class="actions-column">Actions</th></tr></thead><tbody>
    @foreach (var component in Model.Components) { <tr><td><strong>@component.Name</strong><br /><small>@component.Description</small></td><td>@component.Quantity</td><td class="row-actions"><button class="button button-secondary" data-open="edit-component-@component.Id">Edit</button><form method="post" asp-page-handler="DeleteComponent"><input type="hidden" name="ComponentId" value="@component.Id" /><button class="icon-button" title="Delete component" type="submit">Delete</button></form></td></tr> }
    </tbody></table></div>
</section>

<div class="modal" id="new-order"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>New order</h2><form method="post" asp-page-handler="CreateOrder"><label asp-for="OrderName">Name</label><input asp-for="OrderName" required /><label asp-for="OrderDescription">Description</label><textarea asp-for="OrderDescription"></textarea><label asp-for="OrderDate">Order date</label><input asp-for="OrderDate" type="date" required /><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Create order</button></div></form></div></div>
<div class="modal" id="new-board"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>New board</h2><form method="post" asp-page-handler="CreateBoard"><label asp-for="BoardName">Name</label><input asp-for="BoardName" required /><label asp-for="BoardDescription">Description</label><textarea asp-for="BoardDescription"></textarea><div class="form-row"><div><label asp-for="BoardLength">Length</label><input asp-for="BoardLength" type="number" min=".01" step=".01" required /></div><div><label asp-for="BoardWidth">Width</label><input asp-for="BoardWidth" type="number" min=".01" step=".01" required /></div></div><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Create board</button></div></form></div></div>
<div class="modal" id="new-component"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>New component</h2><form method="post" asp-page-handler="CreateComponent"><label asp-for="ComponentName">Name</label><input asp-for="ComponentName" required /><label asp-for="ComponentDescription">Description</label><textarea asp-for="ComponentDescription"></textarea><label asp-for="ComponentQuantity">Quantity</label><input asp-for="ComponentQuantity" type="number" min="0" required /><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Create component</button></div></form></div></div>
@foreach (var order in Model.Orders) { <div class="modal" id="order-@order.Id"><div class="modal-card modal-wide"><button class="modal-close" data-close>×</button><p class="eyebrow">Order relationship</p><h2>@order.Name</h2><p class="muted">Select the boards that should be produced as part of this order.</p><form method="post" asp-page-handler="AssignOrderBoards"><input type="hidden" name="RelationshipOrderId" value="@order.Id" /><input class="modal-search" data-filter="order-@order.Id-options" placeholder="Filter boards..." /><div class="selection-list" id="order-@order.Id-options">@foreach (var board in Model.AvailableBoards) { <label class="selection-item"><input type="checkbox" name="SelectedBoardIds" value="@board.Id" @(order.Boards.Any(item => item.Id == board.Id) ? "checked" : null) /><span><strong>@board.Name</strong><small>@board.Length x @board.Width</small></span></label> }</div><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Save board assignments</button></div></form></div></div> }
@foreach (var order in Model.Orders) { <div class="modal" id="edit-order-@order.Id"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>Edit order</h2><form method="post" asp-page-handler="UpdateOrder"><input type="hidden" name="OrderId" value="@order.Id" /><label>Name</label><input name="OrderName" value="@order.Name" required /><label>Description</label><textarea name="OrderDescription">@order.Description</textarea><label>Order date</label><input name="OrderDate" type="date" value="@order.OrderDate.ToString("yyyy-MM-dd")" required /><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Save changes</button></div></form></div></div> }
@foreach (var board in Model.Boards) { <div class="modal" id="edit-board-@board.Id"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>Edit board</h2><form method="post" asp-page-handler="UpdateBoard"><input type="hidden" name="BoardId" value="@board.Id" /><label>Name</label><input name="BoardName" value="@board.Name" required /><label>Description</label><textarea name="BoardDescription">@board.Description</textarea><div class="form-row"><div><label>Length</label><input name="BoardLength" type="number" min=".01" step=".01" value="@board.Length" required /></div><div><label>Width</label><input name="BoardWidth" type="number" min=".01" step=".01" value="@board.Width" required /></div></div><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Save changes</button></div></form></div></div> }
@foreach (var board in Model.Boards) { <div class="modal" id="board-@board.Id"><div class="modal-card modal-wide"><button class="modal-close" data-close>×</button><p class="eyebrow">Board relationship</p><h2>@board.Name</h2><p class="muted">Select the components placed on this board.</p><form method="post" asp-page-handler="AssignBoardComponents"><input type="hidden" name="RelationshipBoardId" value="@board.Id" /><input class="modal-search" data-filter="board-@board.Id-options" placeholder="Filter components..." /><div class="selection-list" id="board-@board.Id-options">@foreach (var component in Model.AvailableComponents) { <label class="selection-item"><input type="checkbox" name="SelectedComponentIds" value="@component.Id" @(board.Components.Any(item => item.Id == component.Id) ? "checked" : null) /><span><strong>@component.Name</strong><small>Quantity: @component.Quantity</small></span></label> }</div><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Save component assignments</button></div></form></div></div> }
@foreach (var component in Model.Components) { <div class="modal" id="edit-component-@component.Id"><div class="modal-card"><button class="modal-close" data-close>×</button><h2>Edit component</h2><form method="post" asp-page-handler="UpdateComponent"><input type="hidden" name="ComponentId" value="@component.Id" /><label>Name</label><input name="ComponentName" value="@component.Name" required /><label>Description</label><textarea name="ComponentDescription">@component.Description</textarea><label>Quantity</label><input name="ComponentQuantity" type="number" min="0" value="@component.Quantity" required /><div class="modal-actions"><button class="button button-secondary" type="button" data-close>Cancel</button><button class="button" type="submit">Save changes</button></div></form></div></div> }
