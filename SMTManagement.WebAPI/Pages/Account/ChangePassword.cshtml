@page
@model SMTManagement.WebAPI.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<div class="card account-card">
    <div class="account-header">
        <div class="security-icon" aria-hidden="true">🔒</div>
        <div><p class="eyebrow">Account security</p><h1>Change your password</h1><p class="muted">Keep your account secure, <strong>@User.Identity?.Name</strong>.</p></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="error">@Model.ErrorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <p class="success">@Model.SuccessMessage</p>
    }
    <form method="post" class="password-form">
        <div class="password-field">
            <label asp-for="CurrentPassword">Current password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
        </div>
        <span asp-validation-for="CurrentPassword" class="error-text"></span>

        <div class="password-field">
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
        </div>
        <span asp-validation-for="NewPassword" class="error-text"></span>
        <div class="password-help"><strong>Your password should:</strong><span>• contain at least 8 characters</span><span>• be different from your current password</span></div>

        <div class="password-field">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <span asp-validation-for="ConfirmPassword" class="error-text"></span>

        <div class="modal-actions">
            <a class="button button-secondary" asp-page="/Index">Close</a>
            <button class="button" type="submit">Change password</button>
        </div>
    </form>
</div>
