{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/smtmanagement.db;Foreign Keys=True"
  },
  "ApiAuthentication": {
    "Token": "111"
  },
  "Authentication": {
    "InitialUser": {
      "Username": "admin",
      "Password": "123"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "SMTManagement"
    }
  },
  "AllowedHosts": "*"
}
